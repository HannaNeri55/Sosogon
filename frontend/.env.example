# Leave the two URLs empty for local development — requests then go through the
# Vite dev proxy (vite.config.js) to http://localhost:8000.
# Everything starting with VITE_ ends up in the public JS bundle: never put secrets here.

# Production: the backend's address, no trailing slash (e.g. https://stim-api.onrender.com)
VITE_API_URL=
# Production: the public R2 bucket's URL, no trailing slash (e.g. https://pub-xxxx.r2.dev)
VITE_STORAGE_URL=
# Production: this site's own address, no trailing slash (e.g. https://<your-site>.vercel.app).
# Used for the link-preview image in index.html.
VITE_SITE_URL=

# Browser Maps key — restrict it to your site's domain in Google Cloud Console.
VITE_GOOGLE_MAPS_API_KEY=
VITE_GOOGLE_MAPS_MAP_ID=
